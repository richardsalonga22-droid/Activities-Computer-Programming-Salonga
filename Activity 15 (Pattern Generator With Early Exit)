public class PatternGeneratorWithEarlyExit {
    public static void main(String[] args) {

        int size = 5;

        System.out.println("=== Pattern Generator ===");

        for (int row = 1; row <= size; row++) {

            if (row == 3) {
                continue;
            }

            for (int col = 1; col <= row; col++) {


                if (col == 4) {
                    break;
                }

                System.out.print("* ");
            }

            System.out.println();
        }
    }
}

