class Student {
    String name;
    int[] quizzes;

    Student(String name, int[] quizzes) {
        this.name = name;
        this.quizzes = quizzes;
    }

    double getAverage() {
        int sum = 0;

        for (int score : quizzes) {
            sum += score;
        }

        return (double) sum / quizzes.length;
    }
}

public class ClassRankingSystem {




    public static int findStudentRank(Student[] students, String targetName) {
        for (int i = 0; i < students.length; i++) {
            if (students[i].name.equalsIgnoreCase(targetName)) {
                return i + 1;
            }
        }


        return -1;
    }


    public static void sortStudents(Student[] students) {
        for (int i = 0; i < students.length - 1; i++) {
            for (int j = 0; j < students.length - 1 - i; j++) {


                if (students[j].getAverage() < students[j + 1].getAverage()) {
                    /*Swap students to rank from highest to lowest*/
                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }
    }


    public static void main(String[] args) {

        int[][] quizData = {
            {90, 85, 88, 92},
            {95, 90, 93, 92},
            {80, 85, 82, 83},
            {95, 90, 93, 92}, // Tie with the second student
            {88, 87, 89, 86}
        };


        String[] names = {
            "Allec",
            "Tristan",
            "Kyle",
            "Christian",
            "Cedrick"
        };


        Student[] students = new Student[quizData.length];


        for (int i = 0; i < quizData.length; i++) {
            students[i] = new Student(names[i], quizData[i]);
        }

        sortStudents(students);


        System.out.println("======================================");
        System.out.println("           CLASS LEADERBOARD          ");
        System.out.println("======================================");
        System.out.printf("%-8s %-12s %-10s%n", "Rank", "Name", "Average");
        System.out.println("--------------------------------------");

        int rank = 1;

        for (int i = 0; i < students.length; i++) {

            if (i > 0 &&
                students[i].getAverage() != students[i - 1].getAverage()) {
                rank = i + 1;
            }


            System.out.printf("%-8d %-12s %-10.2f%n",
                    rank,
                    students[i].name,
                    students[i].getAverage());
        }


        System.out.println("======================================");

        String searchName = "Diana";
        int foundRank = findStudentRank(students, searchName);

        if (foundRank != -1) {

            int actualRank = 1;


            for (int i = 0; i < students.length; i++) {
                if (students[i].name.equalsIgnoreCase(searchName)) {
                    if (i > 0 &&
                        students[i].getAverage() ==
                        students[i - 1].getAverage()) {


                        actualRank = i;
                    } else {
                        actualRank = i + 1;
                    }
                    break;
                }
            }

            System.out.println("\nSearch Result: " + searchName);
            System.out.println("Rank: " + actualRank);
        } else {
            System.out.println("\nStudent not found: " + searchName);
        }
    }
}
